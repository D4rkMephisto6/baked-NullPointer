{
  "info": {
    "_postman_id": "1f57fc1a-93b9-4bc1-8b62-2c3277ab85d9",
    "name": "NullPointer POS - Sprint 1 (Backend)",
    "description": "Pruebas HU-01, HU-02, HU-03, HU-04, HU-05, HU-06, HU-07 y HU-26. Ordena las solicitudes por número y ejecútalas contra una base recién inicializada. Los usuarios de demo usan PIN 1234; solo para entorno local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health"
        },
        "description": "Prueba inicial para confirmar que el backend está levantado.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API responde UP\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Login MOZO (PIN de demo 1234)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login"
        },
        "description": "La colección guarda el JWT en la variable de entorno token.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"MOZ001\",\n  \"pin\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login MOZO devuelve JWT\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a(\"string\"); pm.environment.set(\"token\", pm.response.json().token); pm.expect(pm.response.json().user.role).to.eql(\"MOZO\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar mesas y guardar M01/M02",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/mesas"
        },
        "description": "Copia los identificadores de las mesas M01 y M02 al entorno de Postman.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Se listan las mesas\", function () { pm.response.to.have.status(200); const tables = pm.response.json(); pm.expect(tables.length).to.be.above(0); const t1 = tables.find(t => t.tableCode === \"M01\"); const t2 = tables.find(t => t.tableCode === \"M02\"); pm.expect(t1).to.exist; pm.expect(t2).to.exist; pm.environment.set(\"tableId\", t1.tableId); pm.environment.set(\"targetTableId\", t2.tableId); });"
            ]
          }
        }
      ]
    },
