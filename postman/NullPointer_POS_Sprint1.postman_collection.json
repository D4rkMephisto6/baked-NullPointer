              "pm.test(\"La mesa de la comanda fue cambiada\", function () { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.orderId).to.eql(Number(pm.environment.get(\"orderId\"))); pm.expect(r.toTableCode).to.eql(\"M02\"); });"
            ]
          }
        }
      ]
    },
