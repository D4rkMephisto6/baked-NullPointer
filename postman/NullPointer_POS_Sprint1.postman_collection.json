              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Hay categorías de menú\", function () { pm.response.to.have.status(200); const categories = pm.response.json(); pm.expect(categories.some(c => c.name === \"Pollos\")).to.eql(true); });"
            ]
          }
        }
      ]
    },
