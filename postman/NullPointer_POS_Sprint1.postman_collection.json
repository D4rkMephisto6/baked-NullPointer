          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Se obtiene el catálogo filtrado\", function () { pm.response.to.have.status(200); const products = pm.response.json(); const p = products.find(item => item.sku === \"POLLO-025\"); pm.expect(p).to.exist; pm.environment.set(\"productId\", p.productId); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Crear comanda en borrador (HU-03/HU-04/HU-05)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pedidos"
        },
        "description": "Requiere una mesa libre (M01 en la base recién inicializada).",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tableId\": \"{{tableId}}\",\n  \"notes\": \"Comanda de prueba de Sprint 1\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1,\n      \"notes\": \"Sin mayonesa\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Se crea comanda en BORRADOR con plato y nota\", function () { pm.response.to.have.status(201); const o = pm.response.json(); pm.expect(o.status).to.eql(\"BORRADOR\"); pm.expect(o.items.length).to.eql(1); pm.expect(o.items[0].notes).to.eql(\"Sin mayonesa\"); pm.environment.set(\"orderId\", o.orderId); pm.environment.set(\"orderCode\", o.orderCode); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Consultar comanda creada",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pedidos/{{orderId}}"
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Comanda consultable por ID\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().orderId).to.eql(Number(pm.environment.get(\"orderId\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Editar cantidades/notas antes de enviar (HU-04/HU-05)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pedidos/{{orderId}}/detalles"
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"notes\": \"Sin mayonesa; papas bien fritas\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"La comanda en borrador fue recalculada\", function () { pm.response.to.have.status(200); const o = pm.response.json(); pm.expect(o.status).to.eql(\"BORRADOR\"); pm.expect(o.items[0].quantity).to.eql(2); pm.expect(o.items[0].notes).to.include(\"papas bien fritas\"); pm.expect(Number(o.totalAmount)).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
