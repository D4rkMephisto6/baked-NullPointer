              "pm.test(\"M02 está ocupada después del envío\", function () { pm.response.to.have.status(200); const t = pm.response.json().find(x => x.tableCode === \"M02\"); pm.expect(t.status).to.eql(\"OCUPADA\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Crear un usuario MOZO (HU-26)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/usuarios"
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"{{qaEmployeeCode}}\",\n  \"fullName\": \"Usuario de prueba creado en Postman\",\n  \"email\": \"qa@example.test\",\n  \"pin\": \"1234\",\n  \"role\": \"MOZO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"qaEmployeeCode\", \"QA\" + Date.now().toString().slice(-9));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Administrador puede crear otro usuario sin exponer el PIN\", function () { pm.response.to.have.status(201); const u = pm.response.json(); pm.expect(u.employeeCode).to.eql(pm.environment.get(\"qaEmployeeCode\")); pm.expect(u.role).to.eql(\"MOZO\"); pm.expect(u.pinHash).to.not.exist; pm.environment.set(\"createdUserId\", u.userId); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Desactivar usuario creado (HU-26)",
      "request": {
        "method": "PATCH",
